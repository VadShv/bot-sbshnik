# Yandex GPT — получите ключ в Yandex Cloud Console (IAM → Сервисные аккаунты)
YANDEX_API_KEY=your_yandex_api_key_here
YANDEX_FOLDER_ID=your_folder_id_here
YANDEX_MODEL=yandexgpt

# Базовая HTTP-авторизация для доступа к приложению
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=change_me_in_production

# Порт (по умолчанию 5000, Render.com сам задаст переменную PORT)
PORT=5000
